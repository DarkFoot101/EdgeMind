# 1. Disable all lifecycle scripts (preinstall, install, postinstall)
# Malicious code cannot execute upon arrival
ignore-scripts=true

# 2. Prevent arbitrary shell script execution via package bin entries
bin-links=false

# 3. Restrict audit to report vulnerabilities automatically
audit=true

# 4. Enforce exact version pinning (disables automatic ^ and ~ range upgrades)
save-exact=true

# 5. Restrict registry to official npm registry only (blocks rogue mirror/proxy injection)
registry=https://registry.npmjs.org/
